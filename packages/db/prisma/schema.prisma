// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums

enum Role {
  student
  teacher
  ta
  admin
}

enum GradingEngine {
  QUERY
  HTTP
}

enum Status {
  available
  unavailable
}

enum Level {
  novice
  adept
  expert
}

enum ExerciseType {
  practice
  exam
}

enum ExerciseStatus {
  complete
  ongoing
  uncomplete
}

enum EnrollStatus {
  active
  unactive
}

enum Verdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TLE
  MLE
  RUNTIME_ERROR
  SYSTEM_ERROR
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum MemberRole {
  TA
  Teacher
}

enum MemberStatus {
  pending
  accepted
  rejected
}

// Models

model Faculty {
  id       Int    @id @default(autoincrement())
  fac_name String

  users Users[]
}

model Users {
  id            Int      @id @default(autoincrement())
  first_name    String
  last_name     String
  student_code  String
  password      String
  email         String?
  role          Role     @default(student)
  profile_image String?
  user_status   Status   @default(available)
  created_at    DateTime @default(now())

  fac_id  Int?
  faculty Faculty? @relation(fields: [fac_id], references: [id])

  enrolls      Enrolls[]
  exercises    Exercises[]
  userExercise user_exercise[]
  course       Courses[]
  courseMember course_member[]
}

model Courses {
  id            Int      @id @default(autoincrement())
  course_name   String
  course_status Status   @default(available)
  created_at    DateTime @default(now())
  creator_id    Int
  slug          String?

  user Users @relation(fields: [creator_id], references: [id])

  enrolls      Enrolls[]
  lectures     Lectures[]
  courseMember course_member[]
}

model Enrolls {
  id            Int          @id @default(autoincrement())
  created_at    DateTime     @default(now())
  enroll_status EnrollStatus @default(active)

  user_id Int
  user    Users @relation(fields: [user_id], references: [id])

  course_id Int
  course    Courses @relation(fields: [course_id], references: [id])

  @@unique([user_id, course_id])
}

model course_member {
  id          Int          @id @default(autoincrement())
  course_role MemberRole
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  status      MemberStatus @default(pending)

  course_id Int
  course    Courses @relation(fields: [course_id], references: [id])

  user_id Int
  user    Users @relation(fields: [user_id], references: [id])

  @@unique([user_id, course_id])
  @@index([course_id])
}

model Exercises {
  id             Int   @id @default(autoincrement())
  exc_name       String
  exc_difficulty Level @default(novice)

  exc_schema   String
  exc_seed     String
  exc_solution String

  order_matters Boolean @default(false)

  exc_status       Status  @default(unavailable)
  exc_description  String?
  exc_anwser_field String?

  exc_update DateTime @updatedAt

  exc_type ExerciseType @default(practice)

  lecture_id Int
  lecture    Lectures @relation(fields: [lecture_id], references: [id])

  author_id Int
  author    Users @relation(fields: [author_id], references: [id])

  exc_engine GradingEngine @default(QUERY)

  testcases    Testcase[]
  userExercise user_exercise[]
}

model Testcase {
  id         Int      @id @default(autoincrement())
  case_name  String
  created_at DateTime @default(now())

  // ลำดับการรัน
  sort_order Int        @default(0)
  method     HttpMethod @default(GET)

  // เช่น /api/books?maxPrice=500
  path    String
  headers Json?

  // Request body สำหรับ POST / PUT
  body Json?

  expected_status Int @default(200)

  // ผลที่ต้องได้แบบตายตัว
  expected_body Json?
  order_matters Boolean @default(true)

  exercise_id Int
  exercise    Exercises @relation(fields: [exercise_id], references: [id])

  @@index([exercise_id])
}

model user_exercise {
  id      Int            @id @default(autoincrement())
  score   Int
  status  ExerciseStatus @default(uncomplete)
  verdict Verdict        @default(PENDING)

  created_at DateTime @default(now())
  update     DateTime @updatedAt

  code           String?
  result         Json?
  graded_at      DateTime @default(now())
  ai_feedback    String?
  attempt_number Int
  exec_time      Int?

  user_id Int
  user    Users @relation(fields: [user_id], references: [id])

  exercise_id Int
  exercise    Exercises @relation(fields: [exercise_id], references: [id])

  @@index([user_id, exercise_id])
}

model Lectures {
  id           Int      @id @default(autoincrement())
  lecture_name String
  lecture_week String
  created_at   DateTime @default(now())
  update       DateTime @updatedAt

  course_id Int
  course    Courses @relation(fields: [course_id], references: [id])

  exercises Exercises[]
  files     Files[]
}

model Files {
  id         Int      @id @default(autoincrement())
  file_key   String
  file_name  String
  file_size  Int
  created_at DateTime @default(now())
  status     Status   @default(available)

  lecture_id Int
  lecture    Lectures @relation(fields: [lecture_id], references: [id])
}